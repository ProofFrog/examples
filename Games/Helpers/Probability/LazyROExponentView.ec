(* ==================================================================== *)
(* LazyROExponentView: a random oracle queried directly and through a    *)
(* secret exponent, sampled lazily with two tables                       *)
(*                                                                        *)
(* EasyCrypt proof of the ProofFrog statistical helper game pair in the    *)
(* co-located LazyROExponentView.game:                                     *)
(*                                                                        *)
(*   Both games sample sk <- ModInt<G.order> \ {0} and return g^sk.        *)
(*   Eager : samples H : GroupElem<G> -> BitString<n> up front;            *)
(*           Hash(m) = H(m), HashExp(c) = H(c^sk).                         *)
(*   Lazy  : HashTable (keyed by m) and ExpTable (keyed by c).  Hash(m)    *)
(*           looks in HashTable, then scans ExpTable for c with c^sk = m,  *)
(*           then samples into HashTable.  HashExp(c) scans HashTable for  *)
(*           the key c^sk, then looks in ExpTable, then samples into       *)
(*           ExpTable.  Neither oracle copies a hit into its own table.    *)
(*                                                                        *)
(* The declared bound is 0.  What is proved is an EQUALITY of             *)
(* probabilities, for every predicate on the adversary's output, under    *)
(* the hypothesis that G.order is prime (the axiom `order_prime`, the      *)
(* counterpart of `requires G.order is prime;`).  The proof uses           *)
(* primality only through `exp_inj`: c |-> c^sk is injective for nonzero  *)
(* sk.  Without it the statement is false (see the .game header).         *)
(*                                                                        *)
(* Modeling notes.                                                        *)
(*  - GroupElem<G> and ModInt<G.order> are the stdlib CyclicGroup and its *)
(*    PowZMod exponent field; ModInt<G.order> \ {0} is dt \ pred1 zero.   *)
(*    FrogLang's Group is a finite cyclic group generated by G.generator, *)
(*    which is what CyclicGroup axiomatizes.                              *)
(*  - BitString<n> is an abstract type R with an arbitrary LOSSLESS       *)
(*    distribution dR (the uniform distribution on BitString<n> is one).  *)
(*    Losslessness is used to move between eager and lazy sampling.       *)
(*  - Eager samples the whole function with dfun, as the .game does.  The *)
(*    proof reaches a lazily sampled map through PROM's FinEager and      *)
(*    FullEager theorems, so no step relies on an unproved eager/lazy     *)
(*    equivalence.                                                        *)
(*  - Lazy is modeled faithfully with its two maps.  The .game's scan of  *)
(*    an entries list with an early return is FMap's `find`.  At most     *)
(*    one entry can match either scan (map keys are distinct, and under   *)
(*    prime order distinct c have distinct c^sk), so which matching entry *)
(*    a scan returns is never in question.                                *)
(*                                                                        *)
(* Proof shape.                                                           *)
(*  1. eager_fun:   Eager = MainD(D(A), FunRO)    (inline, same program). *)
(*  2. fun_lazy:    MainD(D(A), FunRO) = MainD(D(A), LRO)                 *)
(*                  (PROM: FunRO = FinRO = RO = LRO).                     *)
(*  3. lazy_tables: MainD(D(A), LRO) = Lazy, by one byequiv whose         *)
(*     invariant ties the lazy map rf to (HashTable, ExpTable):           *)
(*       (1) k in HashTable => rf.[k]    = HashTable.[k]                  *)
(*       (2) c in ExpTable  => rf.[c^sk] = ExpTable.[c]                   *)
(*       (3) k in rf        => k in HashTable                             *)
(*                             \/ exists c in ExpTable, c^sk = k.         *)
(*     Injectivity is used where HashExp(c) samples fresh: c^sk is new to *)
(*     rf, and the new ExpTable entry does not disturb the others.        *)
(*                                                                        *)
(* Adversary class.  A may not touch the game state (Eager, Lazy) or the  *)
(* proof's auxiliary modules (Mem, and PROM's RO, FRO, FunRO).  It gets   *)
(* pk, makes unboundedly many Hash and HashExp queries, and need not be   *)
(* lossless.                                                              *)
(* ==================================================================== *)

require import AllCore List FMap Distr Dexcepted Group.
require (*--*) PROM.

(* GroupElem<G> for a group of prime order. *)
clone CyclicGroup as G.

axiom order_prime : IntDiv.prime G.order.

clone G.PowZMod as GP with lemma prime_order <- order_prime.
clone GP.FDistr as FD.
import G GP FD GP.ZModE.

(* BitString<n>: arbitrary lossless output distribution. *)
type R.

op dR : R distr.

axiom dR_ll : is_lossless dR.

(* ModInt<G.order> \ {0}. *)
op dsk : exp distr = dt \ pred1 zero.

lemma dsk_nz (sk : exp) : sk \in dsk => sk <> zero.
proof. by rewrite supp_dexcepted. qed.

(* The one use of primality: c |-> c^sk is injective for nonzero sk. *)
lemma exp_inj (sk : exp) (c c' : group) :
  sk <> zero => c ^ sk = c' ^ sk => c = c'.
proof.
move=> nz heq; rewrite log_bij.
apply (ZModpField.mulfI sk nz).
by rewrite -(logrzM c sk) -(logrzM c' sk) heq.
qed.

(* A scan that finds nothing has no matching entry. *)
lemma find_none (P : 'a -> 'b -> bool) (m : ('a, 'b) fmap) :
  find P m = None => forall x, x \in m => !P x (oget m.[x]).
proof.
move=> hn; case: (findP P m) => [_ h|x y hs _ _]; first exact h.
by move: hs; rewrite hn.
qed.

(* The random oracle H : GroupElem<G> -> BitString<n>, over a finite domain. *)
clone import PROM.FullRO as HRO with
  type in_t    <- group,
  type out_t   <- R,
  op   dout    <- (fun (_ : group) => dR),
  type d_in_t  <- unit,
  type d_out_t <- bool.

clone import HRO.FinEager as HFE with
  op FinFrom.enum <- G.elems
proof FinFrom.enum_spec by exact G.elems_spec.

(* -------------------------------------------------------------------- *)
(* The games.                                                             *)
(* -------------------------------------------------------------------- *)

module type Oracles = {
  proc hash(m : group) : R
  proc hashexp(c : group) : R
}.

module type Game = {
  proc initialize() : group
  proc hash(m : group) : R
  proc hashexp(c : group) : R
}.

module type Adv (O : Oracles) = {
  proc distinguish(pk : group) : bool {O.hash, O.hashexp}
}.

module Eager : Game = {
  var sk : exp
  var h  : group -> R

  proc initialize() : group = {
    sk <$ dsk;
    h  <$ MUniFinFun.dfun (fun (_ : group) => dR);
    return g ^ sk;
  }

  proc hash(m : group) : R = {
    return h m;
  }

  proc hashexp(c : group) : R = {
    return h (c ^ sk);
  }
}.

module Lazy : Game = {
  var sk        : exp
  var hashTable : (group, R) fmap
  var expTable  : (group, R) fmap

  proc initialize() : group = {
    sk        <$ dsk;
    hashTable <- empty;
    expTable  <- empty;
    return g ^ sk;
  }

  proc hash(m : group) : R = {
    var r, oc;
    if (m \in hashTable) {
      r <- oget hashTable.[m];
    } else {
      oc <- find (fun (c : group) (_ : R) => m = c ^ sk) expTable;
      if (oc <> None) {
        r <- oget expTable.[oget oc];
      } else {
        r <$ dR;
        hashTable.[m] <- r;
      }
    }
    return r;
  }

  proc hashexp(c : group) : R = {
    var r, om;
    om <- find (fun (k : group) (_ : R) => k = c ^ sk) hashTable;
    if (om <> None) {
      r <- oget hashTable.[oget om];
    } else {
      if (c \in expTable) {
        r <- oget expTable.[c];
      } else {
        r <$ dR;
        expTable.[c] <- r;
      }
    }
    return r;
  }
}.

module Exp (O : Game) (A : Adv) = {
  proc main() : bool = {
    var pk, b;
    pk <@ O.initialize();
    b  <@ A(O).distinguish(pk);
    return b;
  }
}.

(* -------------------------------------------------------------------- *)
(* The intermediate game: Eager with H behind a PROM oracle.             *)
(* -------------------------------------------------------------------- *)

module Mem = {
  var sk : exp
}.

module ROView (H : HRO.RO) : Oracles = {
  proc hash(m : group) : R = {
    var r;
    r <@ H.get(m);
    return r;
  }

  proc hashexp(c : group) : R = {
    var r;
    r <@ H.get(c ^ Mem.sk);
    return r;
  }
}.

module D (A : Adv) (H : HRO.RO) = {
  proc distinguish(u : unit) : bool = {
    var b;
    Mem.sk <$ dsk;
    b      <@ A(ROView(H)).distinguish(g ^ Mem.sk);
    return b;
  }
}.

(* -------------------------------------------------------------------- *)
(* The invariant of step 3 and how each oracle branch keeps it.          *)
(* -------------------------------------------------------------------- *)

op [opaque] inv (rf : (group, R) fmap) (sk : exp) (ht et : (group, R) fmap) =
     sk <> zero
  /\ (forall k, k \in ht => rf.[k] = ht.[k])
  /\ (forall c, c \in et => rf.[c ^ sk] = et.[c])
  /\ (forall k, k \in rf => k \in ht \/ exists c, c \in et /\ c ^ sk = k).

lemma inv_empty sk : sk <> zero => inv empty sk empty empty.
proof. by move=> nz; rewrite /inv nz /=; smt(mem_empty). qed.

(* A point HashTable already holds. *)
lemma inv_ht rf sk ht et k :
  inv rf sk ht et => k \in ht => k \in rf /\ oget rf.[k] = oget ht.[k].
proof. by rewrite /inv; smt(domE). qed.

(* A point ExpTable already holds, at c with c^sk = k. *)
lemma inv_et rf sk ht et k c :
  inv rf sk ht et => c \in et => k = c ^ sk =>
  k \in rf /\ oget rf.[k] = oget et.[c].
proof. by rewrite /inv; smt(domE). qed.

(* Hash(m) at a point neither table holds. *)
lemma inv_hash_fresh rf sk ht et m r :
  inv rf sk ht et => m \notin ht => (forall c, c \in et => m <> c ^ sk) =>
  m \notin rf /\ inv rf.[m <- r] sk ht.[m <- r] et.
proof.
rewrite /inv => -[nz [h1 [h2 h3]]] hm hc.
split; first smt().
split; first done.
split.
+ by move=> k; rewrite mem_set !get_setE; smt().
split.
+ by move=> c hc'; rewrite get_setE; smt().
by move=> k; rewrite !mem_set; smt().
qed.

(* HashExp(c) at a point neither table holds: needs injectivity. *)
lemma inv_exp_fresh rf sk ht et c r :
  inv rf sk ht et => c ^ sk \notin ht => c \notin et =>
  c ^ sk \notin rf /\ inv rf.[c ^ sk <- r] sk ht et.[c <- r].
proof.
rewrite /inv => -[nz [h1 [h2 h3]]] hm hc.
split.
+ apply/negP => /h3 [//|[c' [hc' heq]]].
  by move: hc'; rewrite (exp_inj sk c' c nz heq).
split; first done.
split.
+ by move=> k hk; rewrite get_setE; smt().
split.
+ move=> c'; rewrite mem_set !get_setE.
  case: (c' = c) => [-> //|neq /= hc'].
  have -> /= : c' ^ sk <> c ^ sk by smt(exp_inj).
  exact h2.
move=> k; rewrite mem_set => -[/h3 [-> //|[c' [hc' <-]]]|->].
+ by right; exists c'; rewrite mem_set hc'.
by right; exists c; rewrite mem_set.
qed.

(* -------------------------------------------------------------------- *)
(* The proof.                                                             *)
(* -------------------------------------------------------------------- *)

section PROOF.

declare module A <: Adv {-Eager, -Lazy, -Mem, -RO, -FRO, -FunRO}.

(* Step 1: Eager is MainD(D(A), FunRO) with its two samples reordered. *)
local lemma eager_fun &m (P : bool -> bool) :
  Pr[Exp(Eager, A).main() @ &m : P res]
  = Pr[MainD(D(A), FunRO).distinguish() @ &m : P res].
proof.
byequiv (: ={glob A} ==> ={res}) => //.
proc; inline *; wp.
call (: Eager.sk{1} = Mem.sk{2} /\ Eager.h{1} = FunRO.f{2}).
+ by proc; inline *; auto.
+ by proc; inline *; auto.
by swap{1} 1 1; auto.
qed.

(* Step 2: PROM's eager/lazy theorems. *)
local lemma fun_lazy &m (P : bool -> bool) :
  Pr[MainD(D(A), FunRO).distinguish() @ &m : P res]
  = Pr[MainD(D(A), LRO).distinguish() @ &m : P res].
proof.
have dout_ll : forall (_ : group), is_lossless dR by move=> _; exact dR_ll.
rewrite -(pr_FinRO_FunRO_D dout_ll (D(A)) &m () P).
rewrite -(pr_RO_FinRO_D dout_ll (D(A)) &m () P).
by byequiv (FullEager.RO_LRO (D(A)) dout_ll) => // /> &1 &2 ->.
qed.

(* Step 3: a lazily sampled H is Lazy's two tables. *)
local lemma lazy_tables &m (P : bool -> bool) :
  Pr[MainD(D(A), LRO).distinguish() @ &m : P res]
  = Pr[Exp(Lazy, A).main() @ &m : P res].
proof.
byequiv (: ={glob A} ==> ={res}) => //.
proc; inline *; wp.
call (: Mem.sk{1} = Lazy.sk{2}
        /\ inv RO.m{1} Lazy.sk{2} Lazy.hashTable{2} Lazy.expTable{2}).
+ (* Hash *)
  proc; inline *.
  if{2}.
  + (* m in HashTable *)
    wp; rnd{1}; wp; skip => /> &1 &2 hinv hm.
    have [hin heq] := inv_ht _ _ _ _ _ hinv hm.
    by split; [exact dR_ll | move=> _ r _; rewrite hin /= heq].
  sp 0 1; if{2}.
  + (* a matching entry in ExpTable *)
    wp; rnd{1}; wp; skip => /> &1 &2 hinv hm hoc.
    have [c y [hfind [hc heq]]] := find_not_none _ _ hoc.
    have hc' : c \in Lazy.expTable{2} by rewrite domE hc.
    have [hin hval] := inv_et _ _ _ _ _ _ hinv hc' heq.
    by split; [exact dR_ll | move=> _ r _; rewrite hfind /= hin /= hval].
  (* fresh *)
  wp; rnd; wp; skip => /> &1 &2 hinv hm hoc r _.
  have hnot : forall c, c \in Lazy.expTable{2} => m{2} <> c ^ Lazy.sk{2}.
  + by move=> c hc; have := find_none _ _ hoc c hc.
  have [hfr hinv'] := inv_hash_fresh _ _ _ _ _ r hinv hm hnot.
  by rewrite hfr /= get_set_sameE.
+ (* HashExp *)
  proc; inline *.
  sp 0 1; if{2}.
  + (* the key c^sk in HashTable *)
    wp; rnd{1}; wp; skip => /> &1 &2 hinv hom.
    have [k y [hfind [hk heq]]] := find_not_none _ _ hom.
    have hk' : k \in Lazy.hashTable{2} by rewrite domE hk.
    have [hin hval] := inv_ht _ _ _ _ _ hinv hk'.
    by split; [exact dR_ll | move=> _ r _; rewrite hfind /= -heq hin /= hval].
  if{2}.
  + (* c in ExpTable *)
    wp; rnd{1}; wp; skip => /> &1 &2 hinv hom hc.
    have [hin hval] := inv_et _ _ _ _ (c{2} ^ Lazy.sk{2}) c{2} hinv hc _ => //.
    by split; [exact dR_ll | move=> _ r _; rewrite hin /= hval].
  (* fresh *)
  wp; rnd; wp; skip => /> &1 &2 hinv hom hc r _.
  have hk : c{2} ^ Lazy.sk{2} \notin Lazy.hashTable{2}.
  + by apply/negP => hk; have := find_none _ _ hom _ hk.
  have [hfr hinv'] := inv_exp_fresh _ _ _ _ _ r hinv hk hc.
  by rewrite hfr /= get_set_sameE.
(* Initialization: the same sk, and all maps empty. *)
by auto => /> sk hsk; apply/inv_empty/dsk_nz.
qed.

lemma adv_bound &m (P : bool -> bool) :
  Pr[Exp(Eager, A).main() @ &m : P res] = Pr[Exp(Lazy, A).main() @ &m : P res].
proof. by rewrite (eager_fun &m P) (fun_lazy &m P) (lazy_tables &m P). qed.

end section PROOF.

(* The declared clause, `advantage <= 0`. *)
lemma advantage_le0 (A <: Adv {-Eager, -Lazy, -Mem, -RO, -FRO, -FunRO}) &m :
  `|Pr[Exp(Eager, A).main() @ &m : res] - Pr[Exp(Lazy, A).main() @ &m : res]|
  <= 0%r.
proof. by have /= -> := adv_bound A &m (fun b => b); smt(). qed.
