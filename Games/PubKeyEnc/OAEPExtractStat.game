// OAEP plaintext-extractor pair, STATISTICAL half (identical until bad):
// "real decryption" versus "extractor unless the adversary has queried H
// at the challenge's sStar". Used through an up-to-bad hop in
// Proofs/PubKeyEnc/OAEP_INDCCA_ROM.proof, followed by the computational
// half OAEPExtractComp (see that file).
//
// Both sides are the OAEP IND-CCA game (single challenge, HashG/HashH
// exposing G and H and RECORDING the adversary's queries in GT and HT;
// InS tells whether a ciphertext is the challenge). HashH also records in
// askH whether H was ever queried at the challenge's s (an sk-free event).
// Dec computes the real decryption AND the plaintext-extractor answer mExt
// (from pk, the tables and F.evaluate only). If askH, both sides return the
// real answer. Otherwise the flag is raised when they disagree;
//   Left returns the real answer (so Left IS real decryption),
//   Right returns mExt (so Right decrypts without sk unless askH).
// On a run that never raises the flag the two agree. The flag can only be
// raised while H(sStar) has not been queried, which is what makes its
// probability a purely statistical quantity (see OAEPExtractStatFlag).
//
// At most one (s, r) pair can match a given c (F.evaluate is injective and
// t = r + H(s) fixes r), so the extractor needs no first-match flag.
// k0 = F.k - n - k1 is derived because games cannot state `requires`.

import '../../Primitives/TDP.primitive';

Game Left(TDP F, Int n, Int k1, Function<BitString<F.k - n - k1>, BitString<n + k1>> G, Function<BitString<n + k1>, BitString<F.k - n - k1>> H) {
    F.PublicKey pk;
    F.SecretKey sk;
    Int count;
    Set<BitString<F.k>> S;
    Map<BitString<F.k - n - k1>, BitString<n + k1>> GT;
    Map<BitString<n + k1>, BitString<F.k - n - k1>> HT;
    Bool bad;
    Bool askH;
    Bool challenged;
    BitString<n + k1> sStar;

    F.PublicKey Initialize() {
        [F.PublicKey, F.SecretKey] [pk, sk] = F.KeyGen();
        count = 0;
        bad = false;
        askH = false;
        challenged = false;
        sStar = 0^(n + k1);
        return pk;
    }

    BitString<n + k1> HashG(BitString<F.k - n - k1> x) {
        BitString<n + k1> y = G(x);
        GT[x] = y;
        return y;
    }

    BitString<F.k - n - k1> HashH(BitString<n + k1> x) {
        if (challenged && x == sStar) {
            askH = true;
        }
        BitString<F.k - n - k1> y = H(x);
        HT[x] = y;
        return y;
    }

    BitString<F.k>? Challenge(BitString<n> m) {
        BitString<F.k>? result = None;
        count = count + 1;
        if (count == 1) {
            BitString<F.k - n - k1> r <- BitString<F.k - n - k1>;
            BitString<n + k1> s = (m || 0^k1) + G(r);
            BitString<F.k - n - k1> t = r + H(s);
            BitString<F.k> c = F.evaluate(pk, s || t);
            S = S union c;
            sStar = s;
            challenged = true;
            result = c;
        }
        return result;
    }

    Bool InS(BitString<F.k> c) {
        return c in S;
    }

    BitString<n>? Dec(BitString<F.k> c) {
        if (c in S) {
            return None;
        }
        BitString<F.k> x = F.invert(sk, c);
        BitString<n + k1> s = x[0 : n + k1];
        BitString<F.k - n - k1> t = x[n + k1 : F.k];
        BitString<F.k - n - k1> r = t + H(s);
        BitString<n + k1> p = s + G(r);
        BitString<n>? mExt = None;
        for ([BitString<n + k1>, BitString<F.k - n - k1>] eh in HT.entries) {
            for ([BitString<F.k - n - k1>, BitString<n + k1>] eg in GT.entries) {
                BitString<F.k - n - k1> te = eg[0] + eh[1];
                BitString<n + k1> pe = eh[0] + eg[1];
                if (F.evaluate(pk, eh[0] || te) == c && pe[n : n + k1] == 0^k1) {
                    mExt = pe[0 : n];
                }
            }
        }
        if (p[n : n + k1] == 0^k1) {
            BitString<n> m = p[0 : n];
            if (askH) {
                return m;
            }
            if (mExt != m) {
                bad = true;
            }
            return m;
        }
        if (askH) {
            return None;
        }
        if (mExt != None) {
            bad = true;
        }
        return None;
    }
}

Game Right(TDP F, Int n, Int k1, Function<BitString<F.k - n - k1>, BitString<n + k1>> G, Function<BitString<n + k1>, BitString<F.k - n - k1>> H) {
    F.PublicKey pk;
    F.SecretKey sk;
    Int count;
    Set<BitString<F.k>> S;
    Map<BitString<F.k - n - k1>, BitString<n + k1>> GT;
    Map<BitString<n + k1>, BitString<F.k - n - k1>> HT;
    Bool bad;
    Bool askH;
    Bool challenged;
    BitString<n + k1> sStar;

    F.PublicKey Initialize() {
        [F.PublicKey, F.SecretKey] [pk, sk] = F.KeyGen();
        count = 0;
        bad = false;
        askH = false;
        challenged = false;
        sStar = 0^(n + k1);
        return pk;
    }

    BitString<n + k1> HashG(BitString<F.k - n - k1> x) {
        BitString<n + k1> y = G(x);
        GT[x] = y;
        return y;
    }

    BitString<F.k - n - k1> HashH(BitString<n + k1> x) {
        if (challenged && x == sStar) {
            askH = true;
        }
        BitString<F.k - n - k1> y = H(x);
        HT[x] = y;
        return y;
    }

    BitString<F.k>? Challenge(BitString<n> m) {
        BitString<F.k>? result = None;
        count = count + 1;
        if (count == 1) {
            BitString<F.k - n - k1> r <- BitString<F.k - n - k1>;
            BitString<n + k1> s = (m || 0^k1) + G(r);
            BitString<F.k - n - k1> t = r + H(s);
            BitString<F.k> c = F.evaluate(pk, s || t);
            S = S union c;
            sStar = s;
            challenged = true;
            result = c;
        }
        return result;
    }

    Bool InS(BitString<F.k> c) {
        return c in S;
    }

    BitString<n>? Dec(BitString<F.k> c) {
        if (c in S) {
            return None;
        }
        BitString<F.k> x = F.invert(sk, c);
        BitString<n + k1> s = x[0 : n + k1];
        BitString<F.k - n - k1> t = x[n + k1 : F.k];
        BitString<F.k - n - k1> r = t + H(s);
        BitString<n + k1> p = s + G(r);
        BitString<n>? mExt = None;
        for ([BitString<n + k1>, BitString<F.k - n - k1>] eh in HT.entries) {
            for ([BitString<F.k - n - k1>, BitString<n + k1>] eg in GT.entries) {
                BitString<F.k - n - k1> te = eg[0] + eh[1];
                BitString<n + k1> pe = eh[0] + eg[1];
                if (F.evaluate(pk, eh[0] || te) == c && pe[n : n + k1] == 0^k1) {
                    mExt = pe[0 : n];
                }
            }
        }
        if (p[n : n + k1] == 0^k1) {
            BitString<n> m = p[0 : n];
            if (askH) {
                return m;
            }
            if (mExt != m) {
                bad = true;
            }
            return mExt;
        }
        if (askH) {
            return None;
        }
        if (mExt != None) {
            bad = true;
        }
        return mExt;
    }
}

export as OAEPExtractStat;
