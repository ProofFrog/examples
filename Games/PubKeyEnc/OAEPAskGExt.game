// OAEP "AskG" pair for the extractor world: OAEPAskG plus the sk-free
// bookkeeping the IND-CCA flag lemmas need. Identical until bad (the
// adversary queries G at the hidden rStar); used through an up-to-bad hop
// in Proofs/PubKeyEnc/OAEP_ExtractComp_Flag.proof.
//
// As in OAEPAskG: the pair owns the programmed value u = G(rStar) and the
// challenge encryption (H is a parameter exposed through HashH, InS tells
// whether a ciphertext is the challenge). In addition it records in askH
// whether H was ever queried at the challenge's s (an sk-free event the
// enclosing flag game reveals through AskH), exactly as the OAEPExtract*
// games do. G itself is never touched: a reduction answers HashG through
// TestG / its own G.
//
// k0 = F.k - n - k1 is derived because games cannot state `requires`.
// The flag game OAEPAskGExtFlag carries the bound; see that file.

import '../../Primitives/TDP.primitive';

Game Left(TDP F, Int n, Int k1, Function<BitString<n + k1>, BitString<F.k - n - k1>> H) {
    F.PublicKey pk;
    BitString<F.k - n - k1> rStar;
    BitString<n + k1> u;
    Int count;
    Bool bad;
    Set<BitString<F.k>> S;
    Bool askH;
    Bool challenged;
    BitString<n + k1> sStar;

    F.PublicKey Initialize() {
        [F.PublicKey, F.SecretKey] kp = F.KeyGen();
        pk = kp[0];
        rStar <- BitString<F.k - n - k1>;
        u <- BitString<n + k1>;
        count = 0;
        bad = false;
        askH = false;
        challenged = false;
        sStar = 0^(n + k1);
        return pk;
    }

    [Bool, BitString<n + k1>] TestG(BitString<F.k - n - k1> x) {
        if (x == rStar) {
            bad = true;
            return [true, u];
        }
        return [false, 0^(n + k1)];
    }

    BitString<F.k>? Challenge(BitString<n> m) {
        BitString<F.k>? result = None;
        count = count + 1;
        if (count == 1) {
            BitString<n + k1> s = (m || 0^k1) + u;
            BitString<F.k - n - k1> t = rStar + H(s);
            BitString<F.k> c = F.evaluate(pk, s || t);
            S = S union c;
            sStar = s;
            challenged = true;
            result = c;
        }
        return result;
    }

    Bool InS(BitString<F.k> c) {
        return c in S;
    }

    BitString<F.k - n - k1> HashH(BitString<n + k1> x) {
        if (challenged && x == sStar) {
            askH = true;
        }
        return H(x);
    }

    Bool AskH() {
        return askH;
    }
}

Game Right(TDP F, Int n, Int k1, Function<BitString<n + k1>, BitString<F.k - n - k1>> H) {
    F.PublicKey pk;
    BitString<F.k - n - k1> rStar;
    BitString<n + k1> u;
    Int count;
    Bool bad;
    Set<BitString<F.k>> S;
    Bool askH;
    Bool challenged;
    BitString<n + k1> sStar;

    F.PublicKey Initialize() {
        [F.PublicKey, F.SecretKey] kp = F.KeyGen();
        pk = kp[0];
        rStar <- BitString<F.k - n - k1>;
        u <- BitString<n + k1>;
        count = 0;
        bad = false;
        askH = false;
        challenged = false;
        sStar = 0^(n + k1);
        return pk;
    }

    [Bool, BitString<n + k1>] TestG(BitString<F.k - n - k1> x) {
        if (x == rStar) {
            bad = true;
        }
        return [false, 0^(n + k1)];
    }

    BitString<F.k>? Challenge(BitString<n> m) {
        BitString<F.k>? result = None;
        count = count + 1;
        if (count == 1) {
            BitString<n + k1> s = (m || 0^k1) + u;
            BitString<F.k - n - k1> t = rStar + H(s);
            BitString<F.k> c = F.evaluate(pk, s || t);
            S = S union c;
            sStar = s;
            challenged = true;
            result = c;
        }
        return result;
    }

    Bool InS(BitString<F.k> c) {
        return c in S;
    }

    BitString<F.k - n - k1> HashH(BitString<n + k1> x) {
        if (challenged && x == sStar) {
            askH = true;
        }
        return H(x);
    }

    Bool AskH() {
        return askH;
    }
}

export as OAEPAskGExt;
