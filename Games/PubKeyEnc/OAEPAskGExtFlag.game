// Flag game of OAEPAskGExt (its Right side plus RevealG): Pr[bad] is the
// probability that the adversary queries G at the hidden rStar. Proven in
// Proofs/PubKeyEnc/OAEP_AskGExt_Flag.proof from PDOW + RandomTargetGuessing
// (the reveal oracle is named RevealG because the pair already has AskH).

import '../../Primitives/TDP.primitive';

Game Real(TDP F, Int n, Int k1, Function<BitString<n + k1>, BitString<F.k - n - k1>> H) {
    F.PublicKey pk;
    BitString<F.k - n - k1> rStar;
    BitString<n + k1> u;
    Int count;
    Bool bad;
    Set<BitString<F.k>> S;
    Bool askH;
    Bool challenged;
    BitString<n + k1> sStar;

    F.PublicKey Initialize() {
        [F.PublicKey, F.SecretKey] kp = F.KeyGen();
        pk = kp[0];
        rStar <- BitString<F.k - n - k1>;
        u <- BitString<n + k1>;
        count = 0;
        bad = false;
        askH = false;
        challenged = false;
        sStar = 0^(n + k1);
        return pk;
    }

    [Bool, BitString<n + k1>] TestG(BitString<F.k - n - k1> x) {
        if (x == rStar) {
            bad = true;
        }
        return [false, 0^(n + k1)];
    }

    BitString<F.k>? Challenge(BitString<n> m) {
        BitString<F.k>? result = None;
        count = count + 1;
        if (count == 1) {
            BitString<n + k1> s = (m || 0^k1) + u;
            BitString<F.k - n - k1> t = rStar + H(s);
            BitString<F.k> c = F.evaluate(pk, s || t);
            S = S union c;
            sStar = s;
            challenged = true;
            result = c;
        }
        return result;
    }

    Bool InS(BitString<F.k> c) {
        return c in S;
    }

    BitString<F.k - n - k1> HashH(BitString<n + k1> x) {
        if (challenged && x == sStar) {
            askH = true;
        }
        return H(x);
    }

    Bool AskH() {
        return askH;
    }

    Bool RevealG() {
        return bad;
    }
}

Game Ideal(TDP F, Int n, Int k1, Function<BitString<n + k1>, BitString<F.k - n - k1>> H) {
    F.PublicKey pk;
    BitString<F.k - n - k1> rStar;
    BitString<n + k1> u;
    Int count;
    Bool bad;
    Set<BitString<F.k>> S;
    Bool askH;
    Bool challenged;
    BitString<n + k1> sStar;

    F.PublicKey Initialize() {
        [F.PublicKey, F.SecretKey] kp = F.KeyGen();
        pk = kp[0];
        rStar <- BitString<F.k - n - k1>;
        u <- BitString<n + k1>;
        count = 0;
        bad = false;
        askH = false;
        challenged = false;
        sStar = 0^(n + k1);
        return pk;
    }

    [Bool, BitString<n + k1>] TestG(BitString<F.k - n - k1> x) {
        if (x == rStar) {
            bad = true;
        }
        return [false, 0^(n + k1)];
    }

    BitString<F.k>? Challenge(BitString<n> m) {
        BitString<F.k>? result = None;
        count = count + 1;
        if (count == 1) {
            BitString<n + k1> s = (m || 0^k1) + u;
            BitString<F.k - n - k1> t = rStar + H(s);
            BitString<F.k> c = F.evaluate(pk, s || t);
            S = S union c;
            sStar = s;
            challenged = true;
            result = c;
        }
        return result;
    }

    Bool InS(BitString<F.k> c) {
        return c in S;
    }

    BitString<F.k - n - k1> HashH(BitString<n + k1> x) {
        if (challenged && x == sStar) {
            askH = true;
        }
        return H(x);
    }

    Bool AskH() {
        return askH;
    }

    Bool RevealG() {
        return false;
    }
}

export as OAEPAskGExtFlag;
