// Partial-domain one-wayness (PD-OW) of a trapdoor permutation F on
// F.k-bit strings, split as n1 bits of s and k0 = F.k - n1 bits of t
// (games cannot state `requires`, so k0 is derived rather than passed),
// in the multi-query "Solve" form used throughout these examples for
// search assumptions (compare Group/CDH.game): the challenge is
// y = F.evaluate(pk, sStar || tStar) for uniform sStar (n1 bits) and
// uniform tStar (k0 bits); the adversary wins by submitting sStar to Solve.
//
//   Left:  Solve(s) returns [true, v] if s == sStar, else [false, 0^k0]
//   Right: Solve(s) always returns [false, 0^k0]
//
// Two presentational choices make the game convenient to reduce to; both
// are equivalent to textbook PD-OW with no loss.
//
// 1. Offset form. The adversary passes an offset delta to Initialize and
//    the game sets tStar = delta + v for a fresh uniform v. Since v is
//    fresh, tStar is uniform whatever delta is, so the challenge is the
//    textbook one. (A textbook PD-OW adversary simulates this game by
//    forwarding y and returning tStar + delta in place of v.) The point
//    is that an OAEP reduction that has programmed H(sStar) = v and set
//    t = rStar + v can pass delta = rStar and receive exactly its own
//    challenge shape back, without the engine having to re-parameterize a
//    uniform sample.
// 2. Reveal form. The Left also hands back v through RevealV, but only on
//    a hit (an input equal to sStar). The Left/Right distinguishing
//    advantage is at most the probability that some Solve or RevealV query
//    hits sStar, and that probability is determined by what the adversary
//    sees BEFORE the first hit, which is identical on both sides. Revealing
//    v after the hit changes nothing about the assumption. Two Bool/value
//    oracles rather than one tuple-returning oracle keep the composed games
//    in the `if (challenger.Solve(x))` shape the engine canonicalizes best.
//
// Fujisaki, Okamoto, Pointcheval and Stern (Crypto 2001 / J. Cryptology
// 2004) show that for RSA, PD-OW follows from plain one-wayness; that
// number-theoretic step is out of scope here and PD-OW is assumed directly.

import '../../Primitives/TDP.primitive';

Game Left(TDP F, Int n1) {
    BitString<n1> sStar;
    BitString<F.k - n1> v;

    [F.PublicKey, BitString<F.k>] Initialize(BitString<F.k - n1> delta) {
        [F.PublicKey, F.SecretKey] kp = F.KeyGen();
        sStar <- BitString<n1>;
        v <- BitString<F.k - n1>;
        BitString<F.k - n1> tStar = delta + v;
        return [kp[0], F.evaluate(kp[0], sStar || tStar)];
    }

    Bool Solve(BitString<n1> s) {
        return s == sStar;
    }

    BitString<F.k - n1> RevealV(BitString<n1> s) {
        if (s == sStar) {
            return v;
        }
        return 0^(F.k - n1);
    }
}

Game Right(TDP F, Int n1) {
    BitString<n1> sStar;
    BitString<F.k - n1> v;

    [F.PublicKey, BitString<F.k>] Initialize(BitString<F.k - n1> delta) {
        [F.PublicKey, F.SecretKey] kp = F.KeyGen();
        sStar <- BitString<n1>;
        v <- BitString<F.k - n1>;
        BitString<F.k - n1> tStar = delta + v;
        return [kp[0], F.evaluate(kp[0], sStar || tStar)];
    }

    Bool Solve(BitString<n1> s) {
        return false;
    }

    BitString<F.k - n1> RevealV(BitString<n1> s) {
        return 0^(F.k - n1);
    }
}

export as PDOW;
