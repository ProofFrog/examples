// Helper: collision of the traditional public keys of two CG_seedbased
// key pairs, with the seeds exposed.
//
// Two hybrid seeds seed_0, seed_1 are sampled and handed to the
// adversary (as a LEAK-BIND challenger hands out decapsulation keys).
// Each is expanded with the PRG G exactly as CG_seedbased.DeriveKeyPair
// does, and the nominal-group half is turned into the traditional
// public element ek_T_i = Exp(g, RandomScalar(seed_T_i)).
//
// Real:  Collided answers whether ek_T_0 == ek_T_1.
// Ideal: Collided always answers false.
//
// The two games present the same view and differ only in that one bit,
// which is determined at Initialize by the game's own coins before the
// adversary does anything. So the distinguishing advantage is exactly
//
//     Pr[ek_T_0 == ek_T_1]  over honest CG_seedbased key generation,
//
// and it is the same whether or not the seeds are shown. The companion
// game CGSeededTKeyCollisionEvent.game is the seed-hidden form of the
// same statement; proofs/CG/CG_seedbased_TKeyCollisionEvent.proof
// bounds it in ProofFrog by
//
//     Adv^{PRGSec}_G (two queries) + Adv^{NGKeyCollision}_NG,
//
// which therefore also bounds this game. This is the standard-model
// replacement for the CGLazyROTwoSeeded reprogramming step of the
// PRG-as-random-oracle proofs: the event is a property of key
// generation alone, so a seed being public does not get in the way.
//
// Used by the standard-model LEAK-BIND-K-PK and LEAK-BIND-K-CT
// (two-key case) proofs for CG_seedbased, following the route of
// StarFighters Theorem 28 (ePrint 2025/1397).

import '../../primitives/KEM.primitive';
import '../../primitives/NominalGroup.primitive';
import '../../primitives/PRG.primitive';

Game Real(KEM KEM_PQ, NominalGroup NG, PRG G) {
    NG.Element ek_T_0;
    NG.Element ek_T_1;

    [BitString<G.lambda>, BitString<G.lambda>] Initialize() {
        BitString<G.lambda> seed_0 <- BitString<G.lambda>;
        BitString<G.lambda> seed_1 <- BitString<G.lambda>;
        BitString<G.lambda + G.stretch> seed_full_0 = G.evaluate(seed_0);
        BitString<G.lambda + G.stretch> seed_full_1 = G.evaluate(seed_1);
        BitString<NG.Nseed> seed_T_0 = seed_full_0[KEM_PQ.Nseed : KEM_PQ.Nseed + NG.Nseed];
        BitString<NG.Nseed> seed_T_1 = seed_full_1[KEM_PQ.Nseed : KEM_PQ.Nseed + NG.Nseed];
        ek_T_0 = NG.Exp(NG.Generator(), NG.RandomScalar(seed_T_0));
        ek_T_1 = NG.Exp(NG.Generator(), NG.RandomScalar(seed_T_1));
        return [seed_0, seed_1];
    }

    Bool Collided() {
        return ek_T_0 == ek_T_1;
    }
}

Game Ideal(KEM KEM_PQ, NominalGroup NG, PRG G) {
    NG.Element ek_T_0;
    NG.Element ek_T_1;

    [BitString<G.lambda>, BitString<G.lambda>] Initialize() {
        BitString<G.lambda> seed_0 <- BitString<G.lambda>;
        BitString<G.lambda> seed_1 <- BitString<G.lambda>;
        BitString<G.lambda + G.stretch> seed_full_0 = G.evaluate(seed_0);
        BitString<G.lambda + G.stretch> seed_full_1 = G.evaluate(seed_1);
        BitString<NG.Nseed> seed_T_0 = seed_full_0[KEM_PQ.Nseed : KEM_PQ.Nseed + NG.Nseed];
        BitString<NG.Nseed> seed_T_1 = seed_full_1[KEM_PQ.Nseed : KEM_PQ.Nseed + NG.Nseed];
        ek_T_0 = NG.Exp(NG.Generator(), NG.RandomScalar(seed_T_0));
        ek_T_1 = NG.Exp(NG.Generator(), NG.RandomScalar(seed_T_1));
        return [seed_0, seed_1];
    }

    Bool Collided() {
        return false;
    }
}

export as CGSeededTKeyCollision;
