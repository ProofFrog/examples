// Event game: collision of the traditional encapsulation keys of two
// CK_seedbased key pairs, with the seeds hidden.
//
// Same key generation as CKSeededTKeyCollision.game (two hybrid seeds,
// each expanded with the PRG G and its KEM_T half passed to
// KEM_T.DeriveKeyPair), but nothing is returned to the adversary; the
// only oracle reports the collision bit.
//
// Real:  Collided answers whether ek_T_0 == ek_T_1.
// Ideal: Collided always answers false.
//
// The distinguishing advantage is Pr[ek_T_0 == ek_T_1] (the adversary
// just outputs the bit), the same quantity as for the seed-exposed
// form. Because the seeds are hidden here, the probability can be
// bounded by a game-hopping argument in ProofFrog:
// proofs/CK/CK_seedbased_TKeyCollisionEvent.proof shows
//
//     Adv <= Adv^{PRGSec}_G (two queries) + Adv^{KeyGenEquiv}_{KEM_T}
//                                         + Adv^{KEMKeyCollision}_{KEM_T}.

import '../../primitives/KEM.primitive';
import '../../primitives/PRG.primitive';

Game Real(KEM KEM_PQ, KEM KEM_T, PRG G) {
    Bool collided;

    Void Initialize() {
        BitString<G.lambda> seed_0 <- BitString<G.lambda>;
        BitString<G.lambda> seed_1 <- BitString<G.lambda>;
        BitString<G.lambda + G.stretch> seed_full_0 = G.evaluate(seed_0);
        BitString<G.lambda + G.stretch> seed_full_1 = G.evaluate(seed_1);
        BitString<KEM_T.Nseed> seed_T_0 = seed_full_0[KEM_PQ.Nseed : KEM_PQ.Nseed + KEM_T.Nseed];
        BitString<KEM_T.Nseed> seed_T_1 = seed_full_1[KEM_PQ.Nseed : KEM_PQ.Nseed + KEM_T.Nseed];
        [KEM_T.EncapsKey, KEM_T.DecapsKey] [ek_T_0, dk_T_0] = KEM_T.DeriveKeyPair(seed_T_0);
        [KEM_T.EncapsKey, KEM_T.DecapsKey] [ek_T_1, dk_T_1] = KEM_T.DeriveKeyPair(seed_T_1);
        collided = ek_T_0 == ek_T_1;
    }

    Bool Collided() {
        return collided;
    }
}

Game Ideal(KEM KEM_PQ, KEM KEM_T, PRG G) {
    Bool collided;

    Void Initialize() {
        BitString<G.lambda> seed_0 <- BitString<G.lambda>;
        BitString<G.lambda> seed_1 <- BitString<G.lambda>;
        BitString<G.lambda + G.stretch> seed_full_0 = G.evaluate(seed_0);
        BitString<G.lambda + G.stretch> seed_full_1 = G.evaluate(seed_1);
        BitString<KEM_T.Nseed> seed_T_0 = seed_full_0[KEM_PQ.Nseed : KEM_PQ.Nseed + KEM_T.Nseed];
        BitString<KEM_T.Nseed> seed_T_1 = seed_full_1[KEM_PQ.Nseed : KEM_PQ.Nseed + KEM_T.Nseed];
        [KEM_T.EncapsKey, KEM_T.DecapsKey] [ek_T_0, dk_T_0] = KEM_T.DeriveKeyPair(seed_T_0);
        [KEM_T.EncapsKey, KEM_T.DecapsKey] [ek_T_1, dk_T_1] = KEM_T.DeriveKeyPair(seed_T_1);
        collided = ek_T_0 == ek_T_1;
    }

    Bool Collided() {
        return false;
    }
}

export as CKSeededTKeyCollisionEvent;
