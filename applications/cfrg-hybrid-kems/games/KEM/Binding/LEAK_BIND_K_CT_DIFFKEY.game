// LEAK-BIND-K-CT (DIFFKEY case): the output key K leakage-binds the
// ciphertext CT, where the two ciphertexts are decapsulated under two
// DIFFERENT, independently-generated key pairs.
//
// In CDM24 ("Keeping Up with the KEMs", CCS 2024) notation this is
// X-BIND-P-Q with X=LEAK, P={K}, Q={CT}. For K-CT the public key is in
// neither P nor Q, so CDM24 Fig. 5 lets the adversary choose a bit b and
// sets (sk1, pk1) <- (sk_b, pk_b). This game is the b=1 slice: given two
// honestly-generated secret keys, the adversary constructs ct0, ct1 that
// decapsulate to the same shared secret under dk0 and dk1 respectively.
// The b=0 slice (both ciphertexts under one key) is the companion game
// LEAK_BIND_K_CT_SAMEKEY. A KEM is LEAK-BIND-K-CT secure iff it is secure
// in BOTH games (the adversary picks the b it does better at).
//
// This is the notion targeted by draft-irtf-cfrg-hybrid-kems-10
// section 6.2.2 / 6.4.2.
//
// Implicit-rejection assumption: CDM24 Fig. 5 includes the guard
// "if k_0 = bot or k_1 = bot: return 0". We omit it because
// KEM.primitive declares Decaps as total (SharedSecret, not
// SharedSecret?) -- there is no bot symbol to test against. This is
// sound under the assumption that the KEM is implicitly rejecting,
// which is the case for the FO-style KEMs targeted by
// draft-irtf-cfrg-hybrid-kems-10 (Decaps always returns a
// pseudo-random shared secret, never bot). Explicit-rejection KEMs
// would require extending KEM.primitive.

import '../../../primitives/KEM.primitive';

Game Breakable(KEM K) {
    K.DecapsKey dk0;
    K.DecapsKey dk1;

    [K.EncapsKey, K.DecapsKey, K.EncapsKey, K.DecapsKey] Initialize() {
        [K.EncapsKey, K.DecapsKey] [ek0, dk0] = K.KeyGen();
        [K.EncapsKey, K.DecapsKey] [ek1, dk1] = K.KeyGen();
        return [ek0, dk0, ek1, dk1];
    }

    Bool Challenge(K.Ciphertext ct0, K.Ciphertext ct1) {
        K.SharedSecret ss0 = K.Decaps(dk0, ct0);
        K.SharedSecret ss1 = K.Decaps(dk1, ct1);
        return ss0 == ss1 && ct0 != ct1;
    }
}

Game Unbreakable(KEM K) {
    K.DecapsKey dk0;
    K.DecapsKey dk1;

    [K.EncapsKey, K.DecapsKey, K.EncapsKey, K.DecapsKey] Initialize() {
        [K.EncapsKey, K.DecapsKey] [ek0, dk0] = K.KeyGen();
        [K.EncapsKey, K.DecapsKey] [ek1, dk1] = K.KeyGen();
        return [ek0, dk0, ek1, dk1];
    }

    Bool Challenge(K.Ciphertext ct0, K.Ciphertext ct1) {
        K.SharedSecret ss0 = K.Decaps(dk0, ct0);
        K.SharedSecret ss1 = K.Decaps(dk1, ct1);
        return false;
    }
}

export as LEAK_BIND_K_CT_DIFFKEY;
