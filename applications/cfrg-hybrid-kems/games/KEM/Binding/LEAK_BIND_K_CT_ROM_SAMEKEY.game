// LEAK-BIND-K-CT (SAMEKEY case) in the random oracle model.
//
// ROM analogue of LEAK_BIND_K_CT_SAMEKEY.game (the b=0 slice: both
// ciphertexts decapsulated under a single key pair -- the single-receiver
// / re-encapsulation scenario), parameterized over a random oracle
// Function G_RO (modelling the PRG as an RO). The b=1 slice is
// LEAK_BIND_K_CT_ROM_DIFFKEY. A KEM is LEAK-BIND-K-CT secure iff it is
// secure in BOTH.
//
// Mirrors INDCCA_ROM.game's shape (generic over Set D, Set R), so the
// same game serves CK_seedbased and CG_seedbased by varying the codomain
// at instantiation time.

import '../../../primitives/KEM.primitive';

Game Breakable(KEM K, Set D, Set R, Function<D, R> G_RO) {
    K.DecapsKey dk0;

    [K.EncapsKey, K.DecapsKey] Initialize() {
        [K.EncapsKey, K.DecapsKey] [ek0, dk0] = K.KeyGen();
        return [ek0, dk0];
    }

    Bool Challenge(K.Ciphertext ct0, K.Ciphertext ct1) {
        K.SharedSecret ss0 = K.Decaps(dk0, ct0);
        K.SharedSecret ss1 = K.Decaps(dk0, ct1);
        return ss0 == ss1 && ct0 != ct1;
    }

    R HashG(D x) {
        return G_RO(x);
    }
}

Game Unbreakable(KEM K, Set D, Set R, Function<D, R> G_RO) {
    K.DecapsKey dk0;

    [K.EncapsKey, K.DecapsKey] Initialize() {
        [K.EncapsKey, K.DecapsKey] [ek0, dk0] = K.KeyGen();
        return [ek0, dk0];
    }

    Bool Challenge(K.Ciphertext ct0, K.Ciphertext ct1) {
        K.SharedSecret ss0 = K.Decaps(dk0, ct0);
        K.SharedSecret ss1 = K.Decaps(dk0, ct1);
        return false;
    }

    R HashG(D x) {
        return G_RO(x);
    }
}

export as LEAK_BIND_K_CT_ROM_SAMEKEY;
