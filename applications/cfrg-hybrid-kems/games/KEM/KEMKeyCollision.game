// Key-collision probability of a KEM's honest key generation.
//
// Two independent runs of K.KeyGen() produce the same encapsulation
// key only with some small probability eps_K (for a well-formed KEM,
// roughly 2^-Nseed or less).
//
// Real:  Collided answers whether the two honestly generated
//        encapsulation keys coincide.
// Ideal: Collided always answers false.
//
// The two games differ only in the one bit, and that bit is fixed at
// Initialize by the game's own coins, so the distinguishing advantage
// is exactly Pr[ek0 == ek1] = eps_K. The abstract KEM primitive does
// not fix a key distribution, so the bound is left symbolic rather than
// declared as an advantage clause. The KEM analogue of
// Group/NGKeyCollision.game.

import '../../primitives/KEM.primitive';

Game Real(KEM K) {
    Bool collided;

    Void Initialize() {
        [K.EncapsKey, K.DecapsKey] [ek0, dk0] = K.KeyGen();
        [K.EncapsKey, K.DecapsKey] [ek1, dk1] = K.KeyGen();
        collided = ek0 == ek1;
    }

    Bool Collided() {
        return collided;
    }
}

Game Ideal(KEM K) {
    Bool collided;

    Void Initialize() {
        [K.EncapsKey, K.DecapsKey] [ek0, dk0] = K.KeyGen();
        [K.EncapsKey, K.DecapsKey] [ek1, dk1] = K.KeyGen();
        collided = ek0 == ek1;
    }

    Bool Collided() {
        return false;
    }
}

export as KEMKeyCollision;
