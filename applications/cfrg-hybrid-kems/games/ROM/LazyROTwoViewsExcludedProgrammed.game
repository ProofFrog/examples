// Helper assumption (statistical).
//
// Generic lazy-sampling equivalence for a random oracle
//     H : BitString<P.M> -> BitString<n>
// exposed via two views, with one programmed point:
//   - Direct(m):    direct access; H(mStar) is fixed to yStar,
//                   otherwise returns H(m).
//   - Indirect(q):  indirect access on an excluded domain q != qStar,
//                   returns H(P.Pack(st, q)).
// The caller supplies an injective hash-input packing
// P : (State, Query) -> BitString<M> and a distinguished programmed input
// mStar.  The programmed OUTPUT is sampled inside the game (uniform),
// not supplied by the caller.
//
// Honest:  sample a random function RF; return RF(mStar) as the
//          programmed secret; answer Indirect(q) with RF(P.Pack(st, q))
//          and Direct(m) with RF(m).
//
// Lazy:    sample the programmed value yStar uniformly; store
//          mStar and qStar; maintain two lazy maps
//            HT : BitString<M> -> BitString<n>  (for Direct)
//            QT : Query        -> BitString<n>  (for Indirect)
//          with cross-patching via P.Pack.  Both views route the
//          programmed input mStar to yStar: Direct has a
//          priority branch for m == mStar, and Indirect has a
//          priority branch for P.Pack(st, q) == mStar.
//
// Equivalence is UNCONDITIONAL and holds for ANY caller-supplied
// mStar.  Earlier revisions sampled yStar from the caller and
// relied on the unstated precondition mStar == P.Pack(st, qStar)
// (so that, by injectivity of Pack, no Indirect(q) with q != qStar
// could induce the programmed input).  Both were misuse-prone: a
// non-uniform yStar, or an mStar reachable as P.Pack(st, q)
// for some q != qStar, made the two sides distinguishable.  This
// statement removes both traps: yStar is internal and uniform, and
// the Indirect priority branch routes a colliding query to yStar
// exactly as Honest does (where Indirect(q) = RF(P.Pack(st, q)) =
// RF(mStar) when they collide), so no injectivity precondition is
// needed.  In the intended use mStar == P.Pack(st, qStar) and,
// by injectivity, the Indirect priority branch is never taken; it is
// present only to make the equivalence hold universally.
//
// Derived from
// extras/examples/starfortress/proof/prooffrog/games/LazyROTwoViewsExcludedProgrammed.game.

import '../../primitives/HashInputPacking.primitive';

Game Honest(HashInputPacking P, Int n) {
    P.State st;
    P.Query qStar;
    Function<BitString<P.M>, BitString<n>> RF;

    BitString<n> Initialize(P.State st_in, P.Query qStar_in,
                            BitString<P.M> mStar_in) {
        st = st_in;
        qStar = qStar_in;
        RF <- Function<BitString<P.M>, BitString<n>>;
        return RF(mStar_in);
    }

    BitString<n>? Indirect(P.Query q) {
        if (q == qStar) {
            return None;
        }
        BitString<P.M> m_in = P.Pack(st, q);
        return RF(m_in);
    }

    BitString<n> Direct(BitString<P.M> m) {
        return RF(m);
    }
}

Game Lazy(HashInputPacking P, Int n) {
    P.State st;
    P.Query qStar;
    BitString<P.M> mStar;
    BitString<n> yStar;
    Map<BitString<P.M>, BitString<n>> HT;
    Map<P.Query, BitString<n>> QT;

    BitString<n> Initialize(P.State st_in, P.Query qStar_in,
                            BitString<P.M> mStar_in) {
        st = st_in;
        qStar = qStar_in;
        mStar = mStar_in;
        yStar <- BitString<n>;
        return yStar;
    }

    BitString<n>? Indirect(P.Query q) {
        if (q == qStar) {
            return None;
        }
        if (q in QT) {
            return QT[q];
        }
        BitString<P.M> m_in = P.Pack(st, q);
        if (m_in == mStar) {
            QT[q] = yStar;
            return yStar;
        }
        for ([BitString<P.M>, BitString<n>] e in HT.entries) {
            if (e[0] == m_in) {
                QT[q] = e[1];
                return e[1];
            }
        }
        BitString<n> s <- BitString<n>;
        QT[q] = s;
        return s;
    }

    BitString<n> Direct(BitString<P.M> m) {
        if (m == mStar) {
            return yStar;
        }
        if (m in HT) {
            return HT[m];
        }
        for ([P.Query, BitString<n>] e in QT.entries) {
            BitString<P.M> m_expected = P.Pack(st, e[0]);
            if (m == m_expected) {
                HT[m] = e[1];
                return e[1];
            }
        }
        BitString<n> r <- BitString<n>;
        HT[m] = r;
        return r;
    }
}

// Perfect equivalence: lazy sampling with a uniform internal programmed point
// is identically distributed to a random function (unconditional, any input).
advantage <= 0;

export as LazyROTwoViewsExcludedProgrammed;
