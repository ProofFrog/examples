// Proof that the CK_seedbased hybrid KEM (seeded form) satisfies
// LEAK-BIND-K-CT in the two-key case (DIFFKEY) in the standard model.
//
// Same route as CK_seedbased_LEAK_BIND_K_PK_std.proof: the two key
// pairs are generated independently, so the case split is on the
// traditional encapsulation keys, not on the ciphertexts. No
// assumption on KEM_PQ is used; compare
// CK_seedbased_LEAK_BIND_K_CT_DIFFKEY.proof, which reduces to KEM_PQ's
// binding with the PRG as a random oracle.
//
// Win condition: Decaps(seed_0, ct0) == Decaps(seed_1, ct1) and
// ct0 != ct1. The C2PRICombiner input is
// ss_PQ || ss_T || ct_T || ek_T || label, so:
//
//   Case ek_T_0 != ek_T_1: the KDF inputs differ in the ek_T slot
//     whatever the ciphertexts are, so equal outputs are a KDF
//     collision.
//   Case ek_T_0 == ek_T_1: an event over honest key generation alone;
//     its probability is the advantage of CKSeededTKeyCollision,
//     bounded by PRG security of G, KeyGenEquiv(KEM_T), and KEM_T's
//     key-collision probability (CK_seedbased_TKeyCollisionEvent.proof).
//
// Game sequence (6 entries, 5 hops):
//   0. LEAK_BIND_K_CT_DIFFKEY(hybrid).Breakable
//   1. CKSeededTKeyCollision(KEM_PQ, KEM_T, G).Real  compose R_Coll  (equiv)
//   2. CKSeededTKeyCollision(KEM_PQ, KEM_T, G).Ideal compose R_Coll  (up to bad; event lemma)
//   3. KDFCollisionResistance(H).Breakable   compose R_KDF          (equiv)
//   4. KDFCollisionResistance(H).Unbreakable compose R_KDF          (assumption)
//   5. LEAK_BIND_K_CT_DIFFKEY(hybrid).Unbreakable
//
// Assumptions: KDFCollisionResistance(H); lemma: event bad of
// CKSeededTKeyCollision(KEM_PQ, KEM_T, G) at Initialize.

import '../../primitives/KEM.primitive';
import '../../primitives/PRG.primitive';
import '../../primitives/KDF.primitive';
import '../../primitives/Label.primitive';
import '../../schemes/CK/CK_seedbased.scheme';
import '../../games/KEM/Binding/LEAK_BIND_K_CT_DIFFKEY.game';
import '../../games/KDF/KDFCollisionResistance.game';
import '../../games/Seeded/CKSeededTKeyCollision.game';

proof:

let:
    Int kem_pq_nseed;
    Int kem_pq_nss;
    Int kem_pq_nct;
    Int kem_pq_nek;
    Int kem_t_nseed;
    Int kem_t_nss;
    Int kem_t_nct;
    Int kem_t_nek;
    Int kdf_nout;
    Int nlabel;
    Set KEMPQCiphertextSpace;
    Set KEMPQEncapsKeySpace;
    Set KEMPQDecapsKeySpace;
    Set KEMTCiphertextSpace;
    Set KEMTEncapsKeySpace;
    Set KEMTDecapsKeySpace;
    KEM KEM_PQ = KEM(kem_pq_nseed, kem_pq_nss, kem_pq_nct, kem_pq_nek,
                     BitString<kem_pq_nss>, KEMPQCiphertextSpace, KEMPQEncapsKeySpace, KEMPQDecapsKeySpace);
    KEM KEM_T = KEM(kem_t_nseed, kem_t_nss, kem_t_nct, kem_t_nek,
                    BitString<kem_t_nss>, KEMTCiphertextSpace, KEMTEncapsKeySpace, KEMTDecapsKeySpace);
    PRG G = PRG(kem_pq_nseed, kem_t_nseed);
    KDF H = KDF(kem_pq_nss + kem_t_nss + kem_t_nct + kem_t_nek + nlabel, kdf_nout);
    Label L = Label(nlabel);
    CK_seedbased hybrid = CK_seedbased(KEM_PQ, KEM_T, G, H, L);

assume:
    KDFCollisionResistance(H);

lemma:
    event bad of CKSeededTKeyCollision(KEM_PQ, KEM_T, G) at Initialize by 'CK_seedbased_TKeyCollisionEvent.proof';

theorem:
    LEAK_BIND_K_CT_DIFFKEY(hybrid);

bound:
      advantage(event bad of CKSeededTKeyCollision(KEM_PQ, KEM_T, G) at Initialize compose R_Coll)
    + advantage(KDFCollisionResistance(H) compose R_KDF);

games:
    LEAK_BIND_K_CT_DIFFKEY(hybrid).Breakable against LEAK_BIND_K_CT_DIFFKEY(hybrid).Adversary;

    CKSeededTKeyCollision(KEM_PQ, KEM_T, G).Real  compose R_Coll(KEM_PQ, KEM_T, G, H, L, hybrid) against LEAK_BIND_K_CT_DIFFKEY(hybrid).Adversary;
    CKSeededTKeyCollision(KEM_PQ, KEM_T, G).Ideal compose R_Coll(KEM_PQ, KEM_T, G, H, L, hybrid) against LEAK_BIND_K_CT_DIFFKEY(hybrid).Adversary;

    KDFCollisionResistance(H).Breakable   compose R_KDF(KEM_PQ, KEM_T, G, H, L, hybrid) against LEAK_BIND_K_CT_DIFFKEY(hybrid).Adversary;
    KDFCollisionResistance(H).Unbreakable compose R_KDF(KEM_PQ, KEM_T, G, H, L, hybrid) against LEAK_BIND_K_CT_DIFFKEY(hybrid).Adversary;

    LEAK_BIND_K_CT_DIFFKEY(hybrid).Unbreakable against LEAK_BIND_K_CT_DIFFKEY(hybrid).Adversary;

// R_Coll: takes the two hybrid seeds from the CKSeededTKeyCollision
// challenger, expands them as CK_seedbased.DeriveKeyPair does, and
// hands out the two seeded key pairs. On Challenge it case-splits on
// equal KDF inputs with distinct PQ ciphertexts: equal KDF inputs force
// ct_T_0 == ct_T_1 and ek_T_0 == ek_T_1, so in that case ct0 != ct1
// holds and the challenger's Collided answer (true in Real) supplies
// the outcome. Otherwise the bare hybrid predicate is returned. In
// Ideal the branch is dead, leaving the KDF-collision case.
Reduction R_Coll(KEM KEM_PQ, KEM KEM_T, PRG G, KDF H, Label L, CK_seedbased hybrid)
    compose CKSeededTKeyCollision(KEM_PQ, KEM_T, G) against LEAK_BIND_K_CT_DIFFKEY(hybrid).Adversary {

    KEM_PQ.EncapsKey ek_PQ_0;
    KEM_PQ.EncapsKey ek_PQ_1;
    KEM_PQ.DecapsKey dk_PQ_0;
    KEM_PQ.DecapsKey dk_PQ_1;
    KEM_T.EncapsKey ek_T_0;
    KEM_T.EncapsKey ek_T_1;
    KEM_T.DecapsKey dk_T_0;
    KEM_T.DecapsKey dk_T_1;

    [hybrid.EncapsKey, hybrid.DecapsKey, hybrid.EncapsKey, hybrid.DecapsKey] Initialize() {
        [BitString<G.lambda>, BitString<G.lambda>] [seed_0, seed_1] = challenger.Initialize();
        BitString<G.lambda + G.stretch> seed_full_0 = G.evaluate(seed_0);
        BitString<G.lambda + G.stretch> seed_full_1 = G.evaluate(seed_1);
        BitString<KEM_PQ.Nseed> seed_PQ_0 = seed_full_0[0 : KEM_PQ.Nseed];
        BitString<KEM_PQ.Nseed> seed_PQ_1 = seed_full_1[0 : KEM_PQ.Nseed];
        BitString<KEM_T.Nseed> seed_T_0 = seed_full_0[KEM_PQ.Nseed : KEM_PQ.Nseed + KEM_T.Nseed];
        BitString<KEM_T.Nseed> seed_T_1 = seed_full_1[KEM_PQ.Nseed : KEM_PQ.Nseed + KEM_T.Nseed];
        [KEM_PQ.EncapsKey, KEM_PQ.DecapsKey] [ek_PQ_0, dk_PQ_0] = KEM_PQ.DeriveKeyPair(seed_PQ_0);
        [KEM_PQ.EncapsKey, KEM_PQ.DecapsKey] [ek_PQ_1, dk_PQ_1] = KEM_PQ.DeriveKeyPair(seed_PQ_1);
        [KEM_T.EncapsKey, KEM_T.DecapsKey] [ek_T_0, dk_T_0] = KEM_T.DeriveKeyPair(seed_T_0);
        [KEM_T.EncapsKey, KEM_T.DecapsKey] [ek_T_1, dk_T_1] = KEM_T.DeriveKeyPair(seed_T_1);
        return [[ek_PQ_0, ek_T_0], seed_0, [ek_PQ_1, ek_T_1], seed_1];
    }

    Bool Challenge(hybrid.Ciphertext ct0, hybrid.Ciphertext ct1) {
        KEM_PQ.Ciphertext ct_PQ_0 = ct0[0];
        KEM_T.Ciphertext  ct_T_0  = ct0[1];
        KEM_PQ.Ciphertext ct_PQ_1 = ct1[0];
        KEM_T.Ciphertext  ct_T_1  = ct1[1];
        KEM_PQ.SharedSecret ss_PQ_0 = KEM_PQ.Decaps(dk_PQ_0, ct_PQ_0);
        KEM_PQ.SharedSecret ss_PQ_1 = KEM_PQ.Decaps(dk_PQ_1, ct_PQ_1);
        KEM_T.SharedSecret  ss_T_0  = KEM_T.Decaps(dk_T_0, ct_T_0);
        KEM_T.SharedSecret  ss_T_1  = KEM_T.Decaps(dk_T_1, ct_T_1);
        BitString<H.Nin> kdf_in_0 = KEM_PQ.EncodeSharedSecret(ss_PQ_0) || KEM_T.EncodeSharedSecret(ss_T_0) || KEM_T.EncodeCiphertext(ct_T_0) || KEM_T.EncodeEncapsKey(ek_T_0) || L.get();
        BitString<H.Nin> kdf_in_1 = KEM_PQ.EncodeSharedSecret(ss_PQ_1) || KEM_T.EncodeSharedSecret(ss_T_1) || KEM_T.EncodeCiphertext(ct_T_1) || KEM_T.EncodeEncapsKey(ek_T_1) || L.get();

        if (kdf_in_0 == kdf_in_1 && ct_PQ_0 != ct_PQ_1) {
            return challenger.Collided();
        }
        return H.evaluate(kdf_in_0) == H.evaluate(kdf_in_1) && ct0 != ct1;
    }
}

// R_KDF: reduction to KDFCollisionResistance(H). Generates both seeded
// key pairs locally, recomputes both KDF inputs on Challenge, and
// forwards them to the collision challenger when ct0 != ct1.
Reduction R_KDF(KEM KEM_PQ, KEM KEM_T, PRG G, KDF H, Label L, CK_seedbased hybrid)
    compose KDFCollisionResistance(H) against LEAK_BIND_K_CT_DIFFKEY(hybrid).Adversary {

    KEM_PQ.EncapsKey ek_PQ_0;
    KEM_PQ.EncapsKey ek_PQ_1;
    KEM_PQ.DecapsKey dk_PQ_0;
    KEM_PQ.DecapsKey dk_PQ_1;
    KEM_T.EncapsKey ek_T_0;
    KEM_T.EncapsKey ek_T_1;
    KEM_T.DecapsKey dk_T_0;
    KEM_T.DecapsKey dk_T_1;

    [hybrid.EncapsKey, hybrid.DecapsKey, hybrid.EncapsKey, hybrid.DecapsKey] Initialize() {
        BitString<G.lambda> seed_0 <- BitString<G.lambda>;
        BitString<G.lambda> seed_1 <- BitString<G.lambda>;
        BitString<G.lambda + G.stretch> seed_full_0 = G.evaluate(seed_0);
        BitString<G.lambda + G.stretch> seed_full_1 = G.evaluate(seed_1);
        BitString<KEM_PQ.Nseed> seed_PQ_0 = seed_full_0[0 : KEM_PQ.Nseed];
        BitString<KEM_PQ.Nseed> seed_PQ_1 = seed_full_1[0 : KEM_PQ.Nseed];
        BitString<KEM_T.Nseed> seed_T_0 = seed_full_0[KEM_PQ.Nseed : KEM_PQ.Nseed + KEM_T.Nseed];
        BitString<KEM_T.Nseed> seed_T_1 = seed_full_1[KEM_PQ.Nseed : KEM_PQ.Nseed + KEM_T.Nseed];
        [KEM_PQ.EncapsKey, KEM_PQ.DecapsKey] [ek_PQ_0, dk_PQ_0] = KEM_PQ.DeriveKeyPair(seed_PQ_0);
        [KEM_PQ.EncapsKey, KEM_PQ.DecapsKey] [ek_PQ_1, dk_PQ_1] = KEM_PQ.DeriveKeyPair(seed_PQ_1);
        [KEM_T.EncapsKey, KEM_T.DecapsKey] [ek_T_0, dk_T_0] = KEM_T.DeriveKeyPair(seed_T_0);
        [KEM_T.EncapsKey, KEM_T.DecapsKey] [ek_T_1, dk_T_1] = KEM_T.DeriveKeyPair(seed_T_1);
        return [[ek_PQ_0, ek_T_0], seed_0, [ek_PQ_1, ek_T_1], seed_1];
    }

    Bool Challenge(hybrid.Ciphertext ct0, hybrid.Ciphertext ct1) {
        KEM_PQ.Ciphertext ct_PQ_0 = ct0[0];
        KEM_T.Ciphertext  ct_T_0  = ct0[1];
        KEM_PQ.Ciphertext ct_PQ_1 = ct1[0];
        KEM_T.Ciphertext  ct_T_1  = ct1[1];
        KEM_PQ.SharedSecret ss_PQ_0 = KEM_PQ.Decaps(dk_PQ_0, ct_PQ_0);
        KEM_PQ.SharedSecret ss_PQ_1 = KEM_PQ.Decaps(dk_PQ_1, ct_PQ_1);
        KEM_T.SharedSecret  ss_T_0  = KEM_T.Decaps(dk_T_0, ct_T_0);
        KEM_T.SharedSecret  ss_T_1  = KEM_T.Decaps(dk_T_1, ct_T_1);
        BitString<H.Nin> kdf_in_0 = KEM_PQ.EncodeSharedSecret(ss_PQ_0) || KEM_T.EncodeSharedSecret(ss_T_0) || KEM_T.EncodeCiphertext(ct_T_0) || KEM_T.EncodeEncapsKey(ek_T_0) || L.get();
        BitString<H.Nin> kdf_in_1 = KEM_PQ.EncodeSharedSecret(ss_PQ_1) || KEM_T.EncodeSharedSecret(ss_T_1) || KEM_T.EncodeCiphertext(ct_T_1) || KEM_T.EncodeEncapsKey(ek_T_1) || L.get();

        if (ct0 == ct1) {
            return false;
        }
        return challenger.Challenge(kdf_in_0, kdf_in_1);
    }
}
