// Bound on the event that two CG_seedbased key generations produce the
// same traditional (nominal-group) public key, in the standard model.
//
// CGSeededTKeyCollision is an identical-until-bad pair: both sides sample
// two hybrid seeds, expand each with the PRG G, derive
// ek_T_i = Exp(g, RandomScalar(seed_T_i)) from the nominal-group halves,
// raise `bad` in Initialize when ek_T_0 == ek_T_1, and return the seeds.
// The event depends only on Initialize's coins, so it is stated `at
// Initialize`: the chain plays the stripped game (Initialize alone, the
// seeds not returned), where the seeds are hidden and PRG security applies.
// The two expansions are replaced by uniform strings, whose nominal-group
// halves are two independent uniform NG seeds, i.e. two honest NG key
// generations; the remaining collision probability is the NGKeyCollision
// assumption on NG. In NGKeyCollision.Ideal the collision is never
// reported, so the flag can no longer be raised (the engine's final
// "flag unreachable" hop).
//
// Game sequence:
//   0. CGSeededTKeyCollision(KEM_PQ, NG, G).Ideal   (stripped to Initialize)
//   1. PRGSec(G).Real          compose R_PRG   (equiv)
//   2. PRGSec(G).Random        compose R_PRG   (assumption; 2 queries)
//   3. NGKeyCollision(NG).Real  compose R_NG   (equiv)
//   4. NGKeyCollision(NG).Ideal compose R_NG   (assumption)
//   terminal: bad is unreachable in game 4
//
// Assumptions: PRGSec(G), NGKeyCollision(NG).

import '../../primitives/KEM.primitive';
import '../../primitives/NominalGroup.primitive';
import '../../primitives/PRG.primitive';
import '../../games/PRG/PRGSec.game';
import '../../games/Group/NGKeyCollision.game';
import '../../games/Seeded/CGSeededTKeyCollision.game';

proof:

let:
    Int kem_pq_nseed;
    Int kem_pq_nss;
    Int kem_pq_nct;
    Int kem_pq_nek;
    Int ng_nseed;
    Int ng_nss;
    Int ng_nelem;
    Set KEMPQCiphertextSpace;
    Set KEMPQEncapsKeySpace;
    Set KEMPQDecapsKeySpace;
    Set NGElementSpace;
    Set NGScalarSpace;
    KEM KEM_PQ = KEM(kem_pq_nseed, kem_pq_nss, kem_pq_nct, kem_pq_nek,
                     BitString<kem_pq_nss>, KEMPQCiphertextSpace, KEMPQEncapsKeySpace, KEMPQDecapsKeySpace);
    NominalGroup NG = NominalGroup(ng_nseed, ng_nelem, ng_nss,
                                   NGElementSpace, NGScalarSpace);
    PRG G = PRG(kem_pq_nseed, ng_nseed);

assume:
    PRGSec(G);
    NGKeyCollision(NG);

theorem:
    event bad of CGSeededTKeyCollision(KEM_PQ, NG, G) at Initialize;

bound:
      advantage(PRGSec(G) compose R_PRG)
    + advantage(NGKeyCollision(NG) compose R_NG);

games:
    CGSeededTKeyCollision(KEM_PQ, NG, G).Ideal against CGSeededTKeyCollision(KEM_PQ, NG, G).Adversary;

    PRGSec(G).Real   compose R_PRG(KEM_PQ, NG, G) against CGSeededTKeyCollision(KEM_PQ, NG, G).Adversary;
    PRGSec(G).Random compose R_PRG(KEM_PQ, NG, G) against CGSeededTKeyCollision(KEM_PQ, NG, G).Adversary;

    NGKeyCollision(NG).Real  compose R_NG(KEM_PQ, NG, G) against CGSeededTKeyCollision(KEM_PQ, NG, G).Adversary;
    NGKeyCollision(NG).Ideal compose R_NG(KEM_PQ, NG, G) against CGSeededTKeyCollision(KEM_PQ, NG, G).Adversary;


// R_PRG: obtains the two seed expansions from the PRG challenger
// (under a hidden uniform seed each), derives the nominal-group public
// elements from their NG halves, and raises bad when they collide.
Reduction R_PRG(KEM KEM_PQ, NominalGroup NG, PRG G)
    compose PRGSec(G) against CGSeededTKeyCollision(KEM_PQ, NG, G).Adversary {

    Bool bad;

    Void Initialize() {
        bad = false;
        BitString<G.lambda + G.stretch> seed_full_0 = challenger.Query();
        BitString<G.lambda + G.stretch> seed_full_1 = challenger.Query();
        BitString<NG.Nseed> seed_T_0 = seed_full_0[KEM_PQ.Nseed : KEM_PQ.Nseed + NG.Nseed];
        BitString<NG.Nseed> seed_T_1 = seed_full_1[KEM_PQ.Nseed : KEM_PQ.Nseed + NG.Nseed];
        NG.Element ek_T_0 = NG.Exp(NG.Generator(), NG.RandomScalar(seed_T_0));
        NG.Element ek_T_1 = NG.Exp(NG.Generator(), NG.RandomScalar(seed_T_1));
        if (ek_T_0 == ek_T_1) {
            bad = true;
        }
    }
}

// R_NG: after the PRG hop the NG seeds are fresh uniform strings, which
// is exactly two honest NG key generations; raise bad when the
// NGKeyCollision challenger reports a collision.
Reduction R_NG(KEM KEM_PQ, NominalGroup NG, PRG G)
    compose NGKeyCollision(NG) against CGSeededTKeyCollision(KEM_PQ, NG, G).Adversary {

    Bool bad;

    Void Initialize() {
        challenger.Initialize();
        bad = false;
        if (challenger.Collided()) {
            bad = true;
        }
    }
}
