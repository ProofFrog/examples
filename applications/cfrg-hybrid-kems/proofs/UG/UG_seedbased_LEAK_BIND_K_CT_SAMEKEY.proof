// Proof that UG_seedbased hybrid KEM satisfies LEAK-BIND-K-CT (SAMEKEY).
//
// SAMEKEY (b=0): both ciphertexts are decapsulated under a single hybrid
// key pair. UniversalCombiner: ct_PQ and ct_T both appear in the KDF
// input via injective encodings, so distinct hybrid ciphertexts always
// produce distinct KDF inputs. Thus a same-key binding break (matching
// keys, distinct ciphertexts) immediately yields a KDF collision.
//
// Assumption: KDFCollisionResistance(H).
// Standard four-step template (one reduction).

import '../../primitives/KEM.primitive';
import '../../primitives/NominalGroup.primitive';
import '../../primitives/PRG.primitive';
import '../../primitives/KDF.primitive';
import '../../primitives/Label.primitive';
import '../../schemes/UG/UG_seedbased.scheme';
import '../../games/KEM/Binding/LEAK_BIND_K_CT_SAMEKEY.game';
import '../../games/KDF/KDFCollisionResistance.game';

proof:

let:
    Int kem_pq_nseed;
    Int kem_pq_nss;
    Int kem_pq_nct;
    Int kem_pq_nek;
    Int ng_nseed;
    Int ng_nss;
    Int ng_nelem;
    Int prg_stretch;
    Int kdf_nout;
    Int nlabel;
    Set KEMPQCiphertextSpace;
    Set KEMPQEncapsKeySpace;
    Set KEMPQDecapsKeySpace;
    Set NGElementSpace;
    Set NGScalarSpace;
    KEM KEM_PQ = KEM(kem_pq_nseed, kem_pq_nss, kem_pq_nct, kem_pq_nek,
                     BitString<kem_pq_nss>, KEMPQCiphertextSpace, KEMPQEncapsKeySpace, KEMPQDecapsKeySpace);
    NominalGroup NG = NominalGroup(ng_nseed, ng_nelem, ng_nss,
                                   NGElementSpace, NGScalarSpace);
    PRG G = PRG(kem_pq_nseed, ng_nseed);
    KDF H = KDF(kem_pq_nss + ng_nss + kem_pq_nct + ng_nelem + kem_pq_nek + ng_nelem + nlabel, kdf_nout);
    Label L = Label(nlabel);
    UG_seedbased hybrid = UG_seedbased(KEM_PQ, NG, G, H, L);

assume:
    KDFCollisionResistance(H);

theorem:
    LEAK_BIND_K_CT_SAMEKEY(hybrid);

bound:
    advantage(KDFCollisionResistance(H) compose R);

games:
    LEAK_BIND_K_CT_SAMEKEY(hybrid).Breakable against LEAK_BIND_K_CT_SAMEKEY(hybrid).Adversary;
    KDFCollisionResistance(H).Breakable compose R(KEM_PQ, NG, G, H, L, hybrid) against LEAK_BIND_K_CT_SAMEKEY(hybrid).Adversary;
    KDFCollisionResistance(H).Unbreakable compose R(KEM_PQ, NG, G, H, L, hybrid) against LEAK_BIND_K_CT_SAMEKEY(hybrid).Adversary;
    LEAK_BIND_K_CT_SAMEKEY(hybrid).Unbreakable against LEAK_BIND_K_CT_SAMEKEY(hybrid).Adversary;

Reduction R(KEM KEM_PQ, NominalGroup NG, PRG G, KDF H, Label L, UG_seedbased hybrid)
    compose KDFCollisionResistance(H) against LEAK_BIND_K_CT_SAMEKEY(hybrid).Adversary {

    BitString<G.lambda> seed0;

    [hybrid.EncapsKey, hybrid.DecapsKey] Initialize() {
        [hybrid.EncapsKey, hybrid.DecapsKey] [ek0, seed0] = hybrid.KeyGen();
        return [ek0, seed0];
    }

    Bool Challenge(hybrid.Ciphertext ct0, hybrid.Ciphertext ct1) {
        // Recompute the hybrid.Decaps body (up to the final H.evaluate)
        // for both ciphertexts under the single key seed0.
        BitString<G.lambda + G.stretch> seed_full = G.evaluate(seed0);
        BitString<KEM_PQ.Nseed> seed_PQ = seed_full[0 : KEM_PQ.Nseed];
        BitString<NG.Nseed> seed_T = seed_full[KEM_PQ.Nseed : KEM_PQ.Nseed + NG.Nseed];
        [KEM_PQ.EncapsKey, KEM_PQ.DecapsKey] [ek_PQ, dk_PQ] = KEM_PQ.DeriveKeyPair(seed_PQ);
        NG.Scalar dk_T = NG.RandomScalar(seed_T);
        NG.Element ek_T = NG.Exp(NG.Generator(), dk_T);

        KEM_PQ.Ciphertext ct_PQ_0 = ct0[0];
        NG.Element ct_T_0 = ct0[1];
        KEM_PQ.SharedSecret ss_PQ_0 = KEM_PQ.Decaps(dk_PQ, ct_PQ_0);
        BitString<NG.Nss> ss_T_0 = NG.ElementToSharedSecret(NG.Exp(ct_T_0, dk_T));
        BitString<H.Nin> kdf_in_0 = KEM_PQ.EncodeSharedSecret(ss_PQ_0) || ss_T_0 || KEM_PQ.EncodeCiphertext(ct_PQ_0) || NG.Encode(ct_T_0) || KEM_PQ.EncodeEncapsKey(ek_PQ) || NG.Encode(ek_T) || L.get();

        KEM_PQ.Ciphertext ct_PQ_1 = ct1[0];
        NG.Element ct_T_1 = ct1[1];
        KEM_PQ.SharedSecret ss_PQ_1 = KEM_PQ.Decaps(dk_PQ, ct_PQ_1);
        BitString<NG.Nss> ss_T_1 = NG.ElementToSharedSecret(NG.Exp(ct_T_1, dk_T));
        BitString<H.Nin> kdf_in_1 = KEM_PQ.EncodeSharedSecret(ss_PQ_1) || ss_T_1 || KEM_PQ.EncodeCiphertext(ct_PQ_1) || NG.Encode(ct_T_1) || KEM_PQ.EncodeEncapsKey(ek_PQ) || NG.Encode(ek_T) || L.get();

        if (ct0 == ct1) {
            return false;
        }
        return challenger.Challenge(kdf_in_0, kdf_in_1);
    }
}
