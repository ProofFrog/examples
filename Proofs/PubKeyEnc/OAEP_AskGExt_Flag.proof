// programmed H(s)) and t is fresh on the Right (the PDOW challenge shape).
// H is programmed at sHid by the reduction itself.
Reduction R_Shift2(TDP F, Int n, Int k0, Int k1, Function<BitString<n + k1>, BitString<k0>> H)
    compose UniformXorShift(k0)
    against OAEPAskGExtFlag(F, n, k1, H).Adversary {
    F.PublicKey pk;
    BitString<n + k1> sHid;
    Int count;
    Bool bad;
    Set<BitString<F.k>> S;
    Bool askH;
    Bool challenged;
    BitString<n + k1> sStar;

    F.PublicKey Initialize() {
        [F.PublicKey, F.SecretKey] kp = F.KeyGen();
        pk = kp[0];
        BitString<k0> rStar <- BitString<k0>;
        sHid <- BitString<n + k1>;
        challenger.Initialize(rStar);
        count = 0;
        bad = false;
        askH = false;
        challenged = false;
        sStar = 0^(n + k1);
        return pk;
    }

    [Bool, BitString<n + k1>] TestG(BitString<k0> x) {
        return [false, 0^(n + k1)];
    }

    BitString<F.k>? Challenge(BitString<n> m) {
        BitString<F.k>? result = None;
        count = count + 1;
        if (count == 1) {
            BitString<k0> t = challenger.Shifted();
            BitString<F.k> c = F.evaluate(pk, sHid || t);
            S = S union c;
            sStar = sHid;
            challenged = true;
            result = c;
