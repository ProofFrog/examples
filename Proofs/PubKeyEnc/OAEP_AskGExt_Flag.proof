    BitString<k0> HashH(BitString<n + k1> x) {
        if (challenged && x == sStar) {
            askH = true;
        }
        if (x == sHid) {
            return challenger.Value();
        }
        return H(x);
    }

    Bool AskH() {
        return askH;
    }

    Bool RevealG() {
        return bad;
    }
}


