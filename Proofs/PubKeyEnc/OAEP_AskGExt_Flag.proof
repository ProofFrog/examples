        count = 0;
        bad = false;
        askH = false;
        challenged = false;
        sStar = 0^(n + k1);
        return pk;
    }

    [Bool, BitString<n + k1>] TestG(BitString<k0> x) {
        return [false, 0^(n + k1)];
    }

    BitString<F.k>? Challenge(BitString<n> m) {
        BitString<F.k>? result = None;
        count = count + 1;
        if (count == 1) {
            BitString<k0> t = rStar + hs;
            BitString<F.k> c = F.evaluate(pk, sHid || t);
            S = S union c;
            sStar = sHid;
            challenged = true;
            result = c;
